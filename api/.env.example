# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# Render: set DB_STORAGE=/var/data/events.sqlite AND attach a disk at /var/data.
# The path alone does not make SQLite persistent. Never seed/reset the deployed DB.
# Serve the built Vue app from Express (run npm run build from the root first).
# Leave false when using the normal Vite development server.
SERVE_WEB=false
# In-memory GET response cache (one API process; no Redis required).
CACHE_ENABLED=true
CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=500
# Optional confirmation emails. Disabled unless explicitly set to true.
# Local Mailpit: docker compose up -d mailpit; inbox http://localhost:8025
MAIL_ENABLED=false
MAIL_FROM=Campus Events <events@campus.example>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave both credentials empty for Mailpit. Never commit real credentials.
SMTP_USER=
SMTP_PASSWORD=
# Applies to DNS, connection, greeting and socket inactivity; not a total deadline.
SMTP_TIMEOUT_MS=5000
# Hosted SMTP: use your provider's settings (usually 587 + false for STARTTLS,
# or 465 + true for immediate TLS), sender address and credentials.
# NODE_ENV=test always disables the real mailer, regardless of MAIL_ENABLED.
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
